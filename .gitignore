
# Project public-metadata policy: `.agents/` contains shared skills, but any
# machine/session artifacts below it remain local.
.agents/**/*.local.*
.agents/**/.cache/
.agents/**/cache/
.agents/**/logs/
.agents/**/sessions/
.agents/**/tmp/
.agents/**/*.log

# Python bytecode cache from the sd-ai-command-pack helper scripts.
__pycache__/
*.pyc

# Shared Copilot hooks are public; runtime/session artifacts are not.
.github/copilot/**/.cache/
.github/copilot/**/cache/
.github/copilot/**/logs/
.github/copilot/**/sessions/
.github/copilot/**/tmp/

